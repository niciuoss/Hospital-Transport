# Copie este arquivo para ".env" (mesma pasta) e ajuste o SERVER_IP para o IP
# desta máquina na rede do hospital (ver com "ipconfig").
#
#   copy .env.example .env
#
# O ".env" não vai para o GitHub (está no .gitignore) porque o IP é específico
# de cada máquina onde o sistema roda.

SERVER_IP=192.168.0.252

FRONTEND_PORT=3000
API_PORT=8088
POSTGRES_PORT=5439
